#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>


/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"
      #include "behaviors.dtsi"
    }; 

    combos {
        compatible = "zmk,combos";

        jg_z {
            bindings = <&kp Z>;
            key-positions = <15 16>;
            layers = <7>;
        };

        gp_q {
            bindings = <&kp Q>;
            key-positions = <16 18>;
            layers = <7>;
        };

        dn_th {
            bindings = <&cmb_th>;
            key-positions = <31 32>;
            layers = <7>;
        };

        cl_ch {
            bindings = <&cmb_ch>;
            key-positions = <50 49>;
            layers = <7>;
        };

        sn_sh {
            bindings = <&cmb_sh>;
            key-positions = <30 31>;
            layers = <7>;
        };

        hi_wh {
            bindings = <&cmb_wh>;
            key-positions = <44 43>;
            layers = <7>;
        };

        gm_gh {
            bindings = <&cmb_gh>;
            key-positions = <16 17>;
            layers = <7>;
        };

        pm_ph {
            bindings = <&cmb_ph>;
            key-positions = <18 17>;
            layers = <7>;
        };
    };

     macros {
        cmb_th: cmb_th {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H>;
            label = "CMB_TH";
        };

        cmb_ch: cmb_ch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp H>;
            label = "CMB_CH";
        };

        cmb_sh: cmb_sh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp H>;
            label = "CMB_SH";
        };

        cmb_wh: cmb_wh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp H>;
            label = "CMB_WH";
        };

        cmb_gh: cmb_gh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp H>;
            label = "CMB_GH";
        };

        cmb_ph: cmb_ph {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp P &kp H>;
            label = "CMB_PH";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp GRAVE  &kp N1                &kp N2            &kp N3            &kp N4              &kp N5  &to 0                                                                             &mo 3         &kp N6  &kp N7              &kp N8        &kp N9            &kp N0                &kp MINUS
&kp TAB    &kp Q                 &kp W             &kp E             &kp R               &kp T   &to 5                                                                             &to 7         &kp Y   &kp U               &kp I         &kp O             &kp SEMICOLON         &kp BSLH
&kp ESC    &hm_l LEFT_CONTROL A  &hm_l LEFT_ALT R  &hm_l LEFT_GUI S  &hm_l LEFT_SHIFT T  &kp G   &to 6         &kp LEFT_GUI           &kp LALT          &kp LGUI      &kp RCTRL    &none         &kp H   &hm_r LEFT_SHIFT N  &hm_r LGUI E  &hm_r LEFT_ALT I  &hm_r LEFT_CONTROL O  &kp SQT
&mo 2      &kp Z                 &kp X             &kp C             &kp V               &kp B                                        &kp HOME          &kp PG_UP                                &kp N   &kp M               &kp COMMA     &kp DOT           &kp UNDER             &kp EQUAL
&mo 2      &kp GRAVE             &none             &kp LEFT          &kp RIGHT                   &lt_bspc 1 0  &ht_sptb LEFT_SHIFT 0  &lt 2 ESCAPE      &lt 2 DELETE  &lt 4 ENTER  &lt_sptb 2 0          &kp UP              &kp DOWN      &kp LBKT          &kp RBKT              &mo 2
            >;
        };

        nav {
            display-name = "Nav";
            bindings = <
&none    &none             &none         &none         &none           &none  &trans                                          &none   &none         &none          &none        &none          &none  &none
&kp TAB  &none             &none         &none         &none           &none  &none                                           &none   &kp LG(LEFT)  &kp PAGE_DOWN  &kp PAGE_UP  &kp LG(RIGHT)  &none  &none
&to 0    &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &none  &none   &trans  &trans      &trans  &trans      &none   &kp LEFT      &kp DOWN       &kp UP       &kp RIGHT      &none  &none
&none    &none             &none         &none         &none           &none                  &none       &none                       &kp HOME      &none          &none        &kp END        &none  &none
&mo 2    &kp GRAVE         &none         &kp LEFT      &kp RIGHT              &none   &trans  &none       &none   &caps_word  &trans                &kp UP         &kp DOWN     &none          &none  &none
            >;
        };

        sym {
            display-name = "Sym";
            bindings = <
&none  &none          &none              &none             &none              &none      &none                                            &none  &none  &none           &none         &none           &none             &none
&none  &none          &kp DOUBLE_QUOTES  &kp MINUS         &star_percent      &kp PIPE   &none                                            &none  &none  &none           &none         &none           &none             &none
&none  &kp SEMICOLON  &kp SQT            &lpar_hash        &rpar_dollar       &kp SLASH  &none    &trans  &trans      &trans  &trans      &none  &none  &kp LEFT_SHIFT  &kp LEFT_GUI  &kp LEFT_ALT    &kp LEFT_CONTROL  &none
&none  &kp GRAVE      &at_caret          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &amp_excl                   &trans      &trans                     &none  &none           &none         &none           &none             &none
&none  &none          &none              &none             &none                         &bs_del  &trans  &trans      &trans  &caps_word  &none         &none           &none         &studio_unlock  &none             &none
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        num {
            bindings = <
&trans  &trans        &trans        &trans          &trans      &trans     &trans                                      &trans  &trans  &trans          &trans        &trans        &trans            &trans
&trans  &kp N7        &kp NUMBER_3  &kp NUMBER_4    &kp N5      &kp N8     &trans                                      &trans  &trans  &trans          &trans        &trans        &trans            &trans
&trans  &kp NUMBER_6  &kp N2        &kp N1          &kp N0      &kp N9     &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp LEFT_SHIFT  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &trans
&trans  &trans        &kp SLASH     &kp UNDERSCORE  &kp PERIOD  &kp COMMA                  &trans      &trans                  &trans  &trans          &trans        &trans        &trans            &trans
&trans  &trans        &trans        &trans          &trans                 &trans  &trans  &trans      &trans  &trans  &trans          &trans          &trans        &trans        &trans            &trans
            >;
        };

        qwerty {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &to 0                                               &trans     &trans  &trans  &trans     &trans   &trans    &trans
&trans  &kp Q   &kp W   &kp E   &kp R   &kp T   &to 5                                               &trans     &kp Y   &kp U   &kp I      &kp O    &kp P     &trans
&trans  &kp A   &kp S   &kp D   &kp F   &kp G   &to 6     &trans     &trans      &trans  &trans     &trans     &kp H   &kp J   &kp K      &kp L    &kp SEMI  &trans
&trans  &kp Z   &kp X   &kp C   &kp V   &kp B                        &trans      &trans                        &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &trans
&trans  &trans  &trans  &trans  &trans          &kp BSPC  &kp LSHFT  &trans      &trans  &kp ENTER  &kp SPACE          &trans  &trans     &trans   &trans    &trans
            >;
        };

        rsthd {
            bindings = <
&trans  &trans    &trans  &trans  &trans  &trans  &to 0                                           &trans     &trans  &trans  &trans     &trans    &trans     &trans
&trans  &kp J     &kp C   &kp Y   &kp F   &kp K   &to 5                                           &trans     &kp Z   &kp L   &kp COMMA  &kp U     &kp Q      &trans
&trans  &kp R     &kp S   &kp T   &kp H   &kp D   &to 6  &trans    &trans      &trans  &trans     &trans     &kp M   &kp N   &kp A      &kp I     &kp O      &trans
&trans  &kp FSLH  &kp V   &kp G   &kp P   &kp B                    &trans      &trans                        &kp X   &kp W   &kp DOT    &kp SEMI  &kp MINUS  &trans
&trans  &trans    &trans  &trans  &trans          &kp E  &kp BSPC  &trans      &trans  &kp ENTER  &kp SPACE          &trans  &trans     &trans    &trans     &trans
            >;
        };
    };
};
